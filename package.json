{
  "name": "voxel-sandbox-engine",
  "version": "0.22.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "debug:logs": "node scripts/hitch-log-server.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check_docs_links.mjs",
    "source:check": "node scripts/check_source_hygiene.mjs",
    "test": "node scripts/run_full_tests.mjs",
    "test:focused": "node scripts/run_tests.mjs",
    "test:world": "npm run test:focused -- --group world",
    "test:lighting": "npm run test:focused -- --group lighting",
    "test:partial-terrain": "npm run test:focused -- --group partial-terrain",
    "test:player": "npm run test:focused -- --group player",
    "test:cores": "npm run test:focused -- --group cores",
    "test:debris": "npm run test:focused -- --group debris",
    "test:inventory": "npm run test:focused -- --group inventory",
    "test:menus": "npm run test:focused -- --group menus",
    "test:builder": "npm run test:focused -- --group builder",
    "test:companion": "npm run test:focused -- --group companion",
    "test:npcs": "npm run test:focused -- --group npcs",
    "test:audio": "npm run test:focused -- --group audio",
    "test:workers": "npm run test:focused -- --group workers",
    "test:diagnostics": "npm run test:focused -- --group diagnostics",
    "test:automation": "npm run test:focused -- --group automation",
    "test:settings": "npm run test:focused -- --group settings",
    "test:groups": "node scripts/run_tests.mjs --check-groups",
    "test:selectors": "node --test tests/test_selection.test.mjs",
    "validate": "npm run test && npm run build && git diff --check"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@vercel/blob": "^2.3.3",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "three": "^0.175.0",
    "vite": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/three": "^0.184.0",
    "typescript": "^5.8.3"
  }
}
