{
  "name": "voxel-sandbox-engine",
  "version": "0.10.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "debug:logs": "node scripts/hitch-log-server.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check_docs_links.mjs",
    "source:check": "node scripts/check_source_hygiene.mjs",
    "test": "tsc --noEmit && node scripts/check_source_hygiene.mjs && node scripts/run_tests.mjs && node scripts/check_docs_links.mjs",
    "validate": "npm run test && npm run build && git diff --check"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@vercel/blob": "^2.3.3",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "three": "^0.175.0",
    "vite": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/three": "^0.184.0",
    "typescript": "^5.8.3"
  }
}
